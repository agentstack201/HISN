# Copy to .env.local and fill in. Never commit real values.

# Supabase project settings → API. The anon key is safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Live scanning is OFF unless set to "true". Enable only after verifying the
# network protections in docs/security.md in the environment you deploy to.
LIVE_SCANNING_ENABLED=false
